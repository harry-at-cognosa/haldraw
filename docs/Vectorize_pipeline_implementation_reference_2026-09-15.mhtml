</tr>
<tr>
<td><code>stop_reason: 'refusal'</code></td>
<td><code>model</code></td>
<td><code>The model declined to process this image.</code></td>
</tr>
<tr>
<td><code>stop_reason: 'max_tokens'</code></td>
