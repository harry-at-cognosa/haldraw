<h2 id=3D"appendix-a-end-to-end-pseudo-code">Appendix A =E2=80=94 End-to-en=
d pseudo-code<a class=3D"headerlink" href=3D"file:///private/var/folders/hj=
/hx1hqg8908nf89fbssd6mq5h0000gv/T/92.html#appendix-a-end-to-end-pseudo-code=
" title=3D"Permanent link">=EE=A0=86</a></h2>
<div class=3D"highlight"><pre>procedure VECTORIZE(imageNode ref, onProgress=
):
    -- Step A (renderer)
    imageId =E2=86=90 ref.content.imageId;  fail "not an image" if absent
    onProgress("Preparing image=E2=80=A6")
    blob =E2=86=90 IPC images.get(imageId);  fail "Image bytes not found." =
if null
    (png, W, H) =E2=86=90 IMAGE_TO_PNG(blob.dataUrl)                 -- =C2=
=A7A.3
    settings =E2=86=90 IPC settings.get()
    onProgress("Asking " + settings.vectorizeModel + "=E2=80=A6")

    -- Step B (main, via IPC vectorize:run)
    try  resp =E2=86=90 RUN_VECTORIZE({png, W, H, model: settings.vectorize=
Model})
    catch e: rethrow with Electron's "Error invoking remote method=E2=80=A6=
" prefix removed
    fail "The model found no shapes in this image." if resp.result.shapes i=
s empty

    -- Step C (renderer)
    bg =E2=86=90 board.background or '#ffffff'
    (nodes, edges, low) =E2=86=90 CONVERT_RESULT(resp.result, ref, {W, H}, =
bg)   -- =C2=A74

    -- Step D (renderer store)
    ordered =E2=86=90 layers sorted by (position, createdAt)
    refLayer =E2=86=90 layers[ref.layerId]
    above =E2=86=90 ordered[index(refLayer) + 1]
    layerSpec =E2=86=90 (above exists and above.name =3D=3D "Draft") ? {id:=
 above.id}
                                                         : {name: "Draft", =
abovePosition: refLayer.position or -1}
    INSERT_MANY({nodes, edges}, {layer: layerSpec, group: true, select: tru=
e})   -- Appendix D

    -- Step E
    return {shapes: |nodes|, connectors: |edges|, lowConfidence: low,
            model: resp.model, inputTokens: resp.inputTokens, outputTokens:=
 resp.outputTokens}


procedure IMAGE_TO_PNG(dataUrl):
    mime =E2=86=90 substring between "data:" and ";";  bytes =E2=86=90 base=
64-decode(payload after ",")
    bitmap =E2=86=90 createImageBitmap(Blob(bytes, mime))
    scale =E2=86=90 min(1, 1568 / max(bitmap.w, bitmap.h))
    w =E2=86=90 max(1, round(bitmap.w =C3=97 scale));  h =E2=86=90 max(1, r=
ound(bitmap.h =C3=97 scale))
    canvas(w, h).drawImage(bitmap, 0, 0, w, h) with high smoothing
    return (base64 of canvas PNG without prefix, w, h)


procedure RUN_VECTORIZE(req):                                -- main proces=
s
    if env HALDRAW_VECTORIZE_FAKE:
        raw =E2=86=90 parse file;  problem =E2=86=90 VALIDATE(raw, req.W, r=
eq.H)
        if problem: throw VectorizeError(output, "Fake result rejected: " +=
 problem)
        return {result: raw, model: "fake", inputTokens: 0, outputTokens: 0=
}
    key =E2=86=90 stdout of `security find-generic-password -s haldraw -a a=
nthropic-api-key -w` (5 s), trimmed
    if not key: throw VectorizeError(no-key, "No API key in the keychain. I=
n Terminal, run:\n" + ADD_COMMAND)
    client =E2=86=90 Anthropic(apiKey: key, maxRetries: 2, timeout: 180 s)
    messages =E2=86=90 [ user: [ image(base64 PNG), text("The image is W =
=C3=97 H pixels. Extract its shapes and connectors.") ] ]
    inTok =E2=86=90 0; outTok =E2=86=90 0
    for attempt in 0..1:
        try  msg =E2=86=90 client.messages.create(model: req.model, max_tok=
ens: 16000, system: SYSTEM_PROMPT,
                                          messages, output_config: {format:=
 {type: json_schema, schema: OUTPUT_SCHEMA}})
        catch AuthenticationError =E2=86=92 throw(auth);  NotFoundError =E2=
=86=92 throw(model);  RateLimitError =E2=86=92 throw(network)
              APIConnectionError =E2=86=92 throw(network);  APIError =E2=86=
=92 throw(model, status + message);  else rethrow
        inTok +=3D msg.usage.input_tokens;  outTok +=3D msg.usage.output_to=
kens
        if msg.stop_reason =3D=3D refusal:    throw VectorizeError(model,  =
"The model declined to process this image.")
        if msg.stop_reason =3D=3D max_tokens: throw VectorizeError(output, =
"=E2=80=A6ran out of output tokens=E2=80=A6")
        text =E2=86=90 concat of text blocks
        try  parsed =E2=86=90 JSON.parse(text);  problem =E2=86=90 VALIDATE=
(parsed, req.W, req.H)
        catch: problem =E2=86=90 "Not valid JSON: " + error
        if not problem: return {result: parsed, model: msg.model, inputToke=
ns: inTok, outputTokens: outTok}
        if attempt =3D=3D 0:
            messages.push(assistant: text or "{}")
            messages.push(user: "That output was rejected: " + problem + "\=
nReturn the corrected JSON object only.")
            continue
        throw VectorizeError(output, "The model's output could not be used:=
 " + problem + "\n\n" + text[0:400])
</pre></div>

<h2 id=3D"appendix-b-validateresult-pseudo-code">Appendix B =E2=80=94 valid=
ateResult pseudo-code<a class=3D"headerlink" href=3D"file:///private/var/fo=
lders/hj/hx1hqg8908nf89fbssd6mq5h0000gv/T/92.html#appendix-b-validateresult=
-pseudo-code" title=3D"Permanent link">=EE=A0=86</a></h2>
<div class=3D"highlight"><pre>function VALIDATE(raw, W, H) =E2=86=92 proble=
m string or null:
    if raw is not an object:                 return "Output is not an objec=
t."
    if raw.shapes is not an array:           return 'Missing "shapes" array=
.'
    if raw.connectors is not an array:       return 'Missing "connectors" a=
rray.'
    ids =E2=86=90 =E2=88=85
    for i, s in raw.shapes:
        if s.id is not a non-empty string:   return "Shape i: missing id."
        if s.id =E2=88=88 ids:                       return 'Shape i: dupli=
cate id "s.id".'
        ids =E2=86=90 ids =E2=88=AA {s.id}
        if s.kind =E2=88=89 {rect, ellipse, diamond, text}: return 'Shape s=
.id: unknown kind "s.kind".'
        for k in (x, y, w, h):
            if s[k] is not a finite number:  return "Shape s.id: k must be =
a number."
        if s.w =E2=89=A4 0 or s.h =E2=89=A4 0:               return "Shape =
s.id: w and h must be positive."
        if s.x + s.w &lt; 0 or s.y + s.h &lt; 0 or s.x &gt; W or s.y &gt; H=
:
                                             return "Shape s.id: box lies o=
utside the image (W=C3=97H)."
    for i, c in raw.connectors:
        if c.from =E2=88=89 ids:                     return 'Connector i: "=
from" is not a shape id.'
        if c.to =E2=88=89 ids:                       return 'Connector i: "=
to" is not a shape id.'
        if c.from =3D=3D c.to:                   return "Connector i: from =
and to are the same shape."
    return null
</pre></div>

<h2 id=3D"appendix-c-colour-and-font-size-helpers-pseudo-code">Appendix C =
=E2=80=94 Colour and font-size helpers pseudo-code<a class=3D"headerlink" h=
ref=3D"file:///private/var/folders/hj/hx1hqg8908nf89fbssd6mq5h0000gv/T/92.h=
tml#appendix-c-colour-and-font-size-helpers-pseudo-code" title=3D"Permanent=
 link">=EE=A0=86</a></h2>
<div class=3D"highlight"><pre>function COLOUR(v, fallback):
    return v matches /^#[0-9a-f]{6}$/i ? lowercase(v) : fallback

function CONTRASTING_TEXT(hex):
    (r, g, b) =E2=86=90 channels of hex, each / 255
    lin(c) =E2=86=90 c =E2=89=A4 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055=
) ^ 2.4
    L =E2=86=90 0.2126=C2=B7lin(r) + 0.7152=C2=B7lin(g) + 0.0722=C2=B7lin(b=
)
    return L &gt; 0.35 ? "#0b0d10" : "#ffffff"

function ESTIMATE_FONT_SIZE(text, w, h, kind):
    t =E2=86=90 trim(text);  if t is empty: return 16
    lines =E2=86=90 split(t, "\n");  longest =E2=86=90 max(1, max length of=
 lines)
    if kind =3D=3D text:
        f =E2=86=90 min( h / (|lines| =C3=97 1.25),  w / (longest =C3=97 0.=
55) )
    else:
        k =E2=86=90 kind =3D=3D ellipse ? 0.50 : kind =3D=3D diamond ? 0.40=
 : 0.75
        byArea  =E2=86=90 sqrt( (k =C3=97 w =C3=97 h) / (|t| =C3=97 0.55 =
=C3=97 1.25) )
        byWidth =E2=86=90 (0.9 =C3=97 w) / (min(longest, 24) =C3=97 0.55)
        f =E2=86=90 min(byArea, byWidth)
    return round( clamp(f, 8, 48) )

function CONVERT_RESULT(result, ref, sent, background):
    sx =E2=86=90 ref.width / sent.width;  sy =E2=86=90 ref.height / sent.he=
ight
    base =E2=86=90 defaultStyleForBackground(background);  edgeStroke =E2=
=86=90 defaultEdgeStrokeForBackground(background)
    low =E2=86=90 0
    nodes =E2=86=90 for s in result.shapes:
        isText =E2=86=90 s.kind =3D=3D text;  dashed =E2=86=90 s.confidence=
 &lt; 0.6;  if dashed: low +=3D 1
        width =E2=86=90 max(4, s.w =C3=97 sx);  height =E2=86=90 max(4, s.h=
 =C3=97 sy)
        fill =E2=86=90 isText ? transparent : COLOUR(s.fill, transparent)
        textColor =E2=86=90 COLOUR(s.textColor, fill =E2=89=A0 transparent =
? CONTRASTING_TEXT(fill) : base.color)
        yield { tempId: s.id, type: s.kind,
                x: ref.x + s.x =C3=97 sx, y: ref.y + s.y =C3=97 sy, width, =
height, rotation: 0, locked: false,
                style: base =E2=8A=95 { fill, stroke: isText ? transparent =
: COLOUR(s.stroke, base.stroke), color: textColor,
                                strokeDasharray: (dashed and not isText) ? =
"6 4" : undefined,
                                fontSize: ESTIMATE_FONT_SIZE(s.text, width,=
 height, s.kind),
                                textAlign: isText ? left : base.textAlign, =
verticalAlign: isText ? top : undefined },
                content: { text: s.text or undefined } }
    edges =E2=86=90 for c in result.connectors:
        dashed =E2=86=90 c.confidence &lt; 0.6;  if dashed: low +=3D 1
        yield { fromTemp: c.from, toTemp: c.to, fromNode: null, toNode: nul=
l,
                fromAnchor: auto, toAnchor: auto, fromPoint: null, toPoint:=
 null,
                routing: straight, headStart: none, headEnd: c.headEnd,
                style: { stroke: edgeStroke, strokeWidth: 2, opacity: 1, st=
rokeDasharray: dashed ? "6 4" : undefined },
                label: c.label or undefined }
    return (nodes, edges, low)
</pre></div>

<h2 id=3D"appendix-d-insertmany-pseudo-code">Appendix D =E2=80=94 insertMan=
y pseudo-code<a class=3D"headerlink" href=3D"file:///private/var/folders/hj=
/hx1hqg8908nf89fbssd6mq5h0000gv/T/92.html#appendix-d-insertmany-pseudo-code=
" title=3D"Permanent link">=EE=A0=86</a></h2>
<div class=3D"highlight"><pre>procedure INSERT_MANY({nodes: inNodes, edges:=
 inEdges}, opts):
    prev =E2=86=90 snapshot(nodes, edges, layers)                       -- =
undo point
    now =E2=86=90 Date.now()
    if opts.layer has id:
        layerId =E2=86=90 opts.layer.id
    else:
        for each layer l: if l.position &gt; opts.layer.abovePosition: l.po=
sition +=3D 1
        new =E2=86=90 Layer{ id: newId(), name: opts.layer.name, position: =
opts.layer.abovePosition + 1,
                     visible: true, locked: false, createdAt/updatedAt: now=
 }
        layers =E2=86=90 renumber densely (sort by position, createdAt; ass=
ign 0..n-1)
        mark every changed layer dirty;  layerId =E2=86=90 new.id
    idOf =E2=86=90 {};  groupId =E2=86=90 (opts.group and |inNodes| &gt; 1)=
 ? newId() : null
    z =E2=86=90 maxZIndex(existing nodes) + 1
    for n in inNodes:
        id =E2=86=90 newId();  idOf[n.tempId] =E2=86=90 id
        nodes[id] =E2=86=90 n minus tempId, plus { id, boardId, zIndex: z++=
, groupId, layerId, createdAt/updatedAt: now }
        mark dirty
    for e in inEdges:
        from =E2=86=90 idOf[e.fromTemp];  to =E2=86=90 idOf[e.toTemp];  ski=
p e if either is missing
        id =E2=86=90 newId()
        edges[id] =E2=86=90 e minus temps, plus { id, boardId, fromNode: fr=
om, toNode: to, midpoint: null, labelPoint: null,
                                          layerId, createdAt/updatedAt: now=
 }
        mark dirty
    commit { nodes, edges, layers, currentLayerId: layerId,
             selection: opts.select ? new node ids : unchanged, edgeSelecti=
on: opts.select ? =E2=88=85 : unchanged,
             history: history + prev (bounded), future: [] }
    return { nodeIds, edgeIds, layerId }
</pre></div>

